# =============================================================================
# Local development: copy to .env.local
#   cp .env.example .env.local
#
# Vercel: Project Settings → Environment Variables
#   Add each variable below for Production (and Preview if desired).
#   Redeploy after changing env vars so the new values take effect.
# =============================================================================

# --- Cerebras (server-only; required for AI Generate / Scanner / Games) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional model override (default: gemma-4-31b)
CEREBRAS_MODEL=gemma-4-31b

# --- Supabase (optional — leave blank to use the built-in localStorage demo store) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional, server-only — never expose in the browser or NEXT_PUBLIC_* vars
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
